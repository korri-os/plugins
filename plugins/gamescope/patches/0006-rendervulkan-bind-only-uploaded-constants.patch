From: Korri contributors
Subject: [PATCH] rendervulkan: bind only the uploaded constants as the UBO

dispatch() bound the constants UBO with range VK_WHOLE_SIZE, which
covers the rest of the 8 MB upload buffer. That exceeds
maxUniformBufferRange on most drivers (spec minimum 16384, panvk 1 MiB),
which VUID-VkWriteDescriptorSet-descriptorType-00332 forbids. On panvk
v7 the 12-bit UBO entry count wraps and every composite is black.

Record the size of the uploaded push data and bind exactly that. The
blur pass's second dispatch reuses the previous upload, so offset and
size stay paired.

Korri-local; not upstream.
---
 src/rendervulkan.cpp | 8 +++++++-
 src/rendervulkan.hpp | 1 +
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 28c4dfc..f3d9b43 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -1705,10 +1705,13 @@ void CVulkanCmdBuffer::clearState()
 template<class PushData, class... Args>
 void CVulkanCmdBuffer::uploadConstants(Args&&... args)
 {
+	// 16384 is the smallest maxUniformBufferRange the Vulkan spec allows.
+	static_assert(sizeof(PushData) <= 16384);
 	PushData data(std::forward<Args>(args)...);
 
 	auto [ptr, offset] = m_device->uploadBufferData(sizeof(data));
 	m_renderBufferOffset = offset;
+	m_renderBufferSize = sizeof(data);
 	memcpy(ptr, &data, sizeof(data));
 }
 
@@ -1810,7 +1813,10 @@ void CVulkanCmdBuffer::dispatch(uint32_t x, uint32_t y, uint32_t z)
 
 	scratchDescriptor.buffer = m_device->m_uploadBuffer;
 	scratchDescriptor.offset = m_renderBufferOffset;
-	scratchDescriptor.range = VK_WHOLE_SIZE;
+	// Bind only the constants. VK_WHOLE_SIZE spans the rest of the 8 MB upload
+	// buffer, beyond maxUniformBufferRange (invalid usage). panvk v7's 12-bit
+	// UBO entry count wraps there, and the composite comes out black.
+	scratchDescriptor.range = m_renderBufferSize;
 
 	for (uint32_t i = 0; i < VKR_SAMPLER_SLOTS; i++)
 	{
diff --git a/src/rendervulkan.hpp b/src/rendervulkan.hpp
index 7f00308..3f0bf73 100644
--- a/src/rendervulkan.hpp
+++ b/src/rendervulkan.hpp
@@ -992,6 +992,7 @@ private:
 	std::vector<VulkanTimelinePoint_t> m_ExternalSignals;
 
 	uint32_t m_renderBufferOffset = 0;
+	uint32_t m_renderBufferSize = 0;
 };
 
 uint32_t VulkanFormatToDRM( VkFormat vkFormat, std::optional<bool> obHasAlphaOverride = std::nullopt );
