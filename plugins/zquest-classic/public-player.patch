+	// Four 8x8 meter cells per tile: full, half, quarter, three-quarter.
+	for (int quarter = 0; quarter < 4; ++quarter)
+	{
+		const int fill_width[] = {6, 3, 1, 4};
+		for (int y = 1; y < 7; ++y)
+			for (int x = 1; x < 7; ++x)
+			{
+				int offset = ((quarter / 2) * 8 + y) * 16 + (quarter % 2) * 8 + x;
+				bool edge = x == 1 || x == 6 || y == 1 || y == 6;
+				newtilebuf[0].data[offset] = edge || x <= fill_width[quarter] ? 1 : 0;
