+// The axis that the active scheme assigns to a movement stick, or a resting
+// axis when the scheme's gamepad is absent or lacks that stick or axis.
+static JOYSTICK_AXIS_INFO const& scheme_axis(int32_t pad, int stick_id, int axis_id)
+{
+	static const JOYSTICK_AXIS_INFO resting = {};
+	if (pad < 0 || pad >= MAX_JOYSTICKS)
+		return resting;
+	int stick = active_control_scheme->stick_data[stick_id][axis_id][control_scheme::data_stick];
+	int axis = active_control_scheme->stick_data[stick_id][axis_id][control_scheme::data_axis];
+	if (stick < 0 || stick >= joy[pad].num_sticks || axis < 0 || axis >= joy[pad].stick[stick].num_axis)
+		return resting;
+	return joy[pad].stick[stick].axis[axis];
+}
+
+// Allegro reports a D-pad hat as a digital stick. A hat moves the hero on any
+// gamepad, whichever stick or buttons the scheme assigns to movement.
+static bool hat_held(int32_t pad, int axis, bool positive)
+{
+	ALLEGRO_JOYSTICK* joystick = pad < 0 || pad >= MAX_JOYSTICKS ? nullptr : al_get_joystick(pad);
+	if (!joystick)
+		return false;
+	for (int stick = 0; stick < joy[pad].num_sticks; ++stick)
+	{
+		if (!(al_get_joystick_stick_flags(joystick, stick) & ALLEGRO_JOYFLAG_DIGITAL) || axis >= joy[pad].stick[stick].num_axis)
+			continue;
+		auto const& state = joy[pad].stick[stick].axis[axis];
+		if (positive ? state.d2 : state.d1)
+			return true;
+	}
+	return false;
+}
