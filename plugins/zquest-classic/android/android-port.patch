+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <application
+        android:allowBackup="false"
+        android:label="ZQuest Classic"
+        android:theme="@android:style/Theme.Material.Light.NoActionBar">
+        <activity
+            android:name="org.liballeg.android.PlayerActivity"
+            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
+            android:screenOrientation="landscape"
+            android:exported="false" />
+        <activity
+            android:name=".MainActivity"
+            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
+            android:screenOrientation="landscape"
+            android:exported="true"
+            android:process=":library">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+            <intent-filter>
+                <action android:name="android.intent.action.VIEW" />
+                <category android:name="android.intent.category.DEFAULT" />
+                <category android:name="android.intent.category.BROWSABLE" />
+                <data android:mimeType="application/octet-stream" />
+                <data android:mimeType="application/zip" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
diff --git a/android/app/src/main/java/org/liballeg/android/PlayerActivity.java b/android/app/src/main/java/org/liballeg/android/PlayerActivity.java
new file mode 100644
index 0000000..1bb3616
--- /dev/null
+++ b/android/app/src/main/java/org/liballeg/android/PlayerActivity.java
@@ -0,0 +1,343 @@
+package org.liballeg.android;
+
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.GridLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.util.Log;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Allegro's Android surface with lightweight touch controls layered over it. */
+public final class PlayerActivity extends AllegroActivity {
+    private final Map<View, Integer> heldControls = new HashMap<>();
+    private View controlsOverlay;
+    private View gamePad;
+    private boolean menuHeld = false;
+    private boolean returningToLibrary = false;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+
+    /** Asks the running game to unwind and shut down, as the in-game Quit does. */
+    private native void nativeRequestQuit();
+
+    static {
+        loadAllegroLibrary("allegro");
+        loadAllegroLibrary("allegro_primitives");
+        loadAllegroLibrary("allegro_image");
+        loadAllegroLibrary("allegro_font");
+        loadAllegroLibrary("allegro_audio");
+        loadAllegroLibrary("allegro_acodec");
+        loadAllegroLibrary("allegro_memfile");
+        loadAllegroLibrary("allegro_dialog");
+        // Allegro opens the player with dlopen() from native code, which does not
+        // register the library with the runtime's native method lookup. Loading
+        // it here as well lets Java call into zplayer (the quit request).
+        System.loadLibrary("zplayer");
+    }
+
+    private static void loadAllegroLibrary(String name) {
+        try {
+            System.loadLibrary(name + "-debug");
+        } catch (UnsatisfiedLinkError debugBuildNotFound) {
+            try {
+                System.loadLibrary(name);
+            } catch (UnsatisfiedLinkError releaseBuildNotFound) {
+                releaseBuildNotFound.addSuppressed(debugBuildNotFound);
+                Log.e("ZQuestClassic", "Could not load Allegro library " + name, releaseBuildNotFound);
+                throw releaseBuildNotFound;
+            }
+        }
+    }
+
+    public PlayerActivity() {
+        super("libzplayer.so");
+    }
+
+    @Override
+    public void onCreate(Bundle state) {
+        super.onCreate(state);
+        getWindow().getDecorView().setKeepScreenOn(true);
+    }
+
+    // Allegro creates/replaces its SurfaceView asynchronously after onCreate.
+    // This package-level override runs after that replacement, so the controls
+    // stay on top of the native game surface.
+    @Override
+    void createSurface() {
+        super.createSurface();
+        addTouchControls();
+    }
+
+    private void addTouchControls() {
+        ViewGroup decor = (ViewGroup) getWindow().getDecorView();
+        if (controlsOverlay != null && controlsOverlay.getParent() instanceof ViewGroup) {
+            ((ViewGroup) controlsOverlay.getParent()).removeView(controlsOverlay);
+        }
+        FrameLayout controls = new FrameLayout(this);
+        controls.setFocusable(false);
+
+        // Top Bar
+        LinearLayout topBar = new LinearLayout(this);
+        topBar.setOrientation(LinearLayout.HORIZONTAL);
+        topBar.setGravity(Gravity.CENTER_VERTICAL);
+        topBar.setFocusable(false);
+        topBar.setClickable(false);
+        topBar.setBackground(createTopBarBackground());
+
+        TextView homeButton = makeTopBarButton("Home");
+        homeButton.setOnTouchListener((view, event) -> {
+            int action = event.getActionMasked();
+            if (action == MotionEvent.ACTION_UP) {
+                returnToLibrary();
+            }
+            return true;
+        });
+        topBar.addView(homeButton);
+
+        TextView menuButton = makeTopBarButton("Menu");
+        menuButton.setOnTouchListener((view, event) -> {
+            int action = event.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN) {
+                handleMenuDown();
+            }
+            // ACTION_UP is deliberately ignored: handleMenuDown schedules its own
+            // release so ESC stays held long enough for the game to see a frame.
+            return true;
+        });
+        topBar.addView(menuButton);
+
+        TextView padButton = makeTopBarButton("Pad");
+        padButton.setOnTouchListener((view, event) -> {
+            int action = event.getActionMasked();
+            if (action == MotionEvent.ACTION_UP) {
+                toggleGamePad();
+            }
+            return true;
+        });
+        topBar.addView(padButton);
+
+        // ZC draws its own menu into the top-left corner of the screen, so the
+        // bar goes top-right to stay clear of the menu and of the game HUD,
+        // which lives inside the scaled 640x480 viewport in the middle.
+        FrameLayout.LayoutParams topBarParams = new FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.END);
+        topBarParams.setMargins(0, dp(8), dp(8), 0);
+        controls.addView(topBar, topBarParams);
+
+        // Gamepad Container
+        FrameLayout gamePadContainer = new FrameLayout(this);
+        gamePadContainer.setFocusable(false);
+
+        GridLayout dpad = new GridLayout(this);
+        dpad.setRowCount(3);
+        dpad.setColumnCount(3);
+        addDpadButton(dpad, "↑", KeyEvent.KEYCODE_DPAD_UP, 1, 0);
+        addDpadButton(dpad, "←", KeyEvent.KEYCODE_DPAD_LEFT, 0, 1);
+        addDpadButton(dpad, "→", KeyEvent.KEYCODE_DPAD_RIGHT, 2, 1);
+        addDpadButton(dpad, "↓", KeyEvent.KEYCODE_DPAD_DOWN, 1, 2);
+
+        FrameLayout.LayoutParams dpadParams = new FrameLayout.LayoutParams(dp(168), dp(168), Gravity.START | Gravity.BOTTOM);
+        dpadParams.setMargins(dp(18), 0, 0, dp(20));
+        gamePadContainer.addView(dpad, dpadParams);
+
+        LinearLayout faceButtons = new LinearLayout(this);
+        faceButtons.setOrientation(LinearLayout.VERTICAL);
+        faceButtons.setGravity(Gravity.CENTER);
+
+        LinearLayout topRow = new LinearLayout(this);
+        topRow.addView(makeControl("L", KeyEvent.KEYCODE_Q, dp(56)));
+        topRow.addView(makeControl("R", KeyEvent.KEYCODE_W, dp(56)));
+        faceButtons.addView(topRow);
+
+        LinearLayout actionRow = new LinearLayout(this);
+        actionRow.addView(makeControl("B", KeyEvent.KEYCODE_X, dp(68)));
+        actionRow.addView(makeControl("A", KeyEvent.KEYCODE_Z, dp(68)));
+        faceButtons.addView(actionRow);
+
+        LinearLayout menuRow = new LinearLayout(this);
+        menuRow.addView(makeControl("Map", KeyEvent.KEYCODE_SPACE, dp(56)));
+        menuRow.addView(makeControl("Start", KeyEvent.KEYCODE_ENTER, dp(56)));
+        faceButtons.addView(menuRow);
+
+        FrameLayout.LayoutParams faceParams = new FrameLayout.LayoutParams(-2, -2, Gravity.END | Gravity.BOTTOM);
+        faceParams.setMargins(0, 0, dp(18), dp(16));
+        gamePadContainer.addView(faceButtons, faceParams);
+
+        gamePad = gamePadContainer;
+        
+        // Restore visibility state
+        boolean isVisible = getSharedPreferences("zquestclassic", MODE_PRIVATE).getBoolean("controls-visible", true);
+        gamePad.setVisibility(isVisible ? View.VISIBLE : View.GONE);
+
+        controls.addView(gamePad, new ViewGroup.LayoutParams(-1, -1));
+
+        controlsOverlay = controls;
+        decor.addView(controlsOverlay, new ViewGroup.LayoutParams(-1, -1));
+    }
+
+    private GradientDrawable createTopBarBackground() {
+        GradientDrawable shape = new GradientDrawable();
+        shape.setShape(GradientDrawable.RECTANGLE);
+        shape.setColor(Color.argb(150, 20, 24, 32));
+        shape.setCornerRadius(dp(8));
+        return shape;
+    }
+
+    private TextView makeTopBarButton(String label) {
+        TextView button = new TextView(this);
+        button.setText(label);
+        button.setTextColor(Color.WHITE);
+        button.setTextSize(14);
+        button.setGravity(Gravity.CENTER);
+        button.setFocusable(false);
+        button.setBackground(background(false));
+        
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-2, dp(40));
+        params.setMargins(dp(4), 0, dp(4), 0);
+        button.setLayoutParams(params);
+        
+        // Add padding to make it look like a button
+        button.setPadding(dp(12), 0, dp(12), 0);
+        
+        return button;
+    }
+
+    private void handleMenuDown() {
+        if (menuHeld) {
+            return;
+        }
+        menuHeld = true;
+        sendKey(KeyEvent.KEYCODE_ESCAPE, KeyEvent.ACTION_DOWN);
+        
+        mainHandler.postDelayed(() -> {
+            if (menuHeld) {
+                menuHeld = false;
+                sendKey(KeyEvent.KEYCODE_ESCAPE, KeyEvent.ACTION_UP);
+            }
+        }, 300);
+    }
+
+    private void toggleGamePad() {
+        if (gamePad == null) return;
+        
+        boolean currentlyVisible = gamePad.getVisibility() == View.VISIBLE;
+        boolean newState = !currentlyVisible;
+        
+        gamePad.setVisibility(newState ? View.VISIBLE : View.GONE);
+        
+        getSharedPreferences("zquestclassic", MODE_PRIVATE)
+            .edit()
+            .putBoolean("controls-visible", newState)
+            .apply();
+    }
+
+    // The library runs in its own process, so the game can shut its own process
+    // down when it stops without taking the library with it. Asking the game to
+    // stop and letting it finish itself are two separate steps: the native loop
+    // has to unwind and shut Allegro down before the Activity may be destroyed.
+    private void returnToLibrary() {
+        if (returningToLibrary) return;
+        returningToLibrary = true;
+        for (View view : new java.util.ArrayList<>(heldControls.keySet())) releaseControl(view);
+        releaseMenuKey();
+        nativeRequestQuit();
+    }
+
+    private void releaseMenuKey() {
+        if (menuHeld) {
+            menuHeld = false;
+            sendKey(KeyEvent.KEYCODE_ESCAPE, KeyEvent.ACTION_UP);
+        }
+    }
+
+    private void addDpadButton(GridLayout grid, String label, int keyCode, int column, int row) {
+        TextView button = makeControl(label, keyCode, dp(54));
+        GridLayout.LayoutParams params = new GridLayout.LayoutParams(
+                GridLayout.spec(row), GridLayout.spec(column));
+        params.width = dp(54);
+        params.height = dp(54);
+        params.setMargins(dp(1), dp(1), dp(1), dp(1));
