     private lateinit var mButtonLayout: RelativeLayout
 
+    // Korri: the touch pad hides while a physical controller is connected.
+    private var inputManager: InputManager? = null
+    private val deviceListener = object : InputManager.InputDeviceListener {
+        override fun onInputDeviceAdded(deviceId: Int) = updateTouchPadVisibility()
+        override fun onInputDeviceRemoved(deviceId: Int) = updateTouchPadVisibility()
+        override fun onInputDeviceChanged(deviceId: Int) = updateTouchPadVisibility()
+    }
+
+    private fun isControllerConnected(): Boolean = InputDevice.getDeviceIds().any { id ->
+        val device = InputDevice.getDevice(id) ?: return@any false
+        if (device.isVirtual) return@any false
+        val sources = device.sources
+        val pad = (sources and InputDevice.SOURCE_GAMEPAD) == InputDevice.SOURCE_GAMEPAD ||
+            (sources and InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK
+        pad && (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q || device.isExternal)
+    }
+
+    private fun updateTouchPadVisibility() {
+        if (::mButtonLayout.isInitialized) {
+            mButtonLayout.visibility = if (isControllerConnected()) View.GONE else View.VISIBLE
+        }
+    }
+
