# Turns one catalogue entry into one ordinary plugin package.
#
# The generator writes a plugin.ts and puts the shared RetroArch launch helper
# beside it, then hands that directory to the normal plugin builder. A
# generated plugin passes through the same admission as a hand-written one: it
# has no private interface and receives no extra authority.
{ pkgs, mkPlugin }:
name: spec:
let
  lib = pkgs.lib;
  # A catalogue entry may name its own frontend build through `frontend`.
  # Omitting it takes nixpkgs' RetroArch, which is what every entry does today.
  # An override changes this core only: every other core keeps its own closure,
  # and the settings evidence is re-derived from the selected binary.
  frontend = import ../retroarch/plugin.nix (
    { inherit pkgs; } // lib.optionalAttrs (spec ? frontend) { base = spec.frontend; }
  );

  pluginId = "@korri:${name}";
  runnerId = "${pluginId}/${name}";
  # Sort system ids so the rendered file is stable across evaluations.
  systemIds = lib.sort builtins.lessThan spec.systems;
  systems = import ./systems.nix;
  groups = lib.filterAttrs (_: group: lib.length (lib.intersectLists systemIds group.systems) >= 2) (
    import ./groups.nix
  );

  json = builtins.toJSON;
  # Upstream names info files after the actual library, not the catalogue key.
  # libretro-core-info is v1.22.2 from the publisher's locked nixpkgs.
  coreInfo = "${pkgs.libretro-core-info}/share/retroarch/cores/${lib.removeSuffix ".so" (builtins.baseNameOf spec.coreFile)}.info";

  systemEntries = lib.concatMapStringsSep "\n" (
    id:
    "  ${json id}: { id: ${json id}, title: ${json systems.${id}.title}, "
    + "content: ${json systems.${id}.content}"
    + lib.optionalString (
      systems.${id} ? panes
    ) ", panes: ${json systems.${id}.panes}, arrangement: ${json systems.${id}.arrangement}"
    + " },"
  ) systemIds;

  pluginTemplate = pkgs.writeText "korri-core-plugin-${name}.ts" ''
    // Generated from plugins/libretro/{cores,systems,groups}.nix. Do not edit this file.
    // Edit the catalogue or shared system rules instead.
    export { handlers } from "./retroarch"

    export const name = ${json name}
    export const title = ${json spec.title}
    export const description = ${json spec.description}
    export const systems = {
    ${systemEntries}
    }
    ${lib.optionalString (groups != { }) "export const groups = ${json groups}"}
    export const runners = {
      ${json name}: {
        id: ${json runnerId},
        family: "@korri:retroarch",
        program: "retroarch",
        core: ${json name},
        systems: ${json systemIds},${
          lib.optionalString (spec ? layouts) "\n        layouts: ${json spec.layouts},"
        }
        // @netplay@
      },
    }
    export const controls = {
      openMenu: {
        order: 0,
        id: ${json "${pluginId}/open-menu"},
        owner: { kind: "runner", id: ${json runnerId} },
        label: "Open RetroArch menu",
        interaction: { kind: "command" },
        effect: "@korri:retroarch/open-menu",
        dismissOnSuccess: true,
      },
      quit: {
        order: 1,
        id: ${json "${pluginId}/quit"},
        owner: { kind: "runner", id: ${json runnerId} },
        label: "Quit game",
        interaction: { kind: "command" },
        effect: "@korri:retroarch/quit",
        destructive: true,
        dismissOnSuccess: true,
      },
    }
  '';

  # The source is built on the same architecture as the core. A cross builder
  # cannot dlopen its target library; native publication builders must do this.
  pluginSource =
    assert lib.assertMsg (pkgs.stdenv.buildPlatform.canExecute pkgs.stdenv.hostPlatform)
      "libretro netplay metadata requires a native build machine";
    pkgs.runCommand "korri-core-plugin-${name}.ts"
      {
        nativeBuildInputs = [ pkgs.buildPackages.python3 ];
      }
      ''
        python3 ${./generate-netplay.py} \
          --template ${pluginTemplate} \
          --core-info ${lib.escapeShellArg coreInfo} \
          --core ${lib.escapeShellArg spec.coreFile} \
          --output "$out"
      '';

  # The generated runner names its program and core by key, and both keys land
  # in one merged set. A catalogue entry that reuses a frontend key would
  # replace the frontend entry with no message, and the runner would then point
  # its program at a core library. That failure would first appear at launch on
  # a device, so refuse it here instead.
  frontendKeys = lib.unique (lib.attrNames frontend.packages ++ lib.attrNames frontend.files);

  # Regular files, never symlinks: the builder refuses a symlinked source.
  # policy.ts owns the nested schema; render-settings.ts owns native output.
  # settings.ts is the selected frontend's source-checked cfg-key/type evidence.
  # All stay effect-free TS source. The host owns no parallel settings schema.
  source = pkgs.runCommand "korri-core-source-${name}" { } ''
    mkdir -p "$out"
    cp ${./retroarch.ts} "$out/retroarch.ts"
    cp ${../retroarch/policy.ts} "$out/policy.ts"
    cp ${../retroarch/render-settings.ts} "$out/render-settings.ts"
    cp ${frontend.packages.retroarch-settings}/settings.ts "$out/settings.ts"
    cp ${pluginSource} "$out/plugin.ts"
    chmod u+w "$out/retroarch.ts" "$out/settings.ts" "$out/plugin.ts"
  '';
in
assert lib.assertMsg (!lib.elem name frontendKeys) (
  "libretro catalogue entry ${name} collides with the RetroArch frontend key "
  + "${name}. Rename the catalogue entry; a core may not replace a frontend "
  + "package or file."
);
# The package is what a device installs. The source is exposed beside it so
# checks and fixtures can read the exact generated text.
(mkPlugin {
  publisher.namespace = "@korri";
  inherit source;
  # The runner carries its own frontend and its own core. Two cores installed
  # together share one RetroArch store path; they never share a dependency the
  # player can remove.
  plugin =
    { pkgs }:
    {
      # RetroArch 1.22.2's GET_STATUS reads the current core's info record and
      # dereferences its system_id. Without an info directory that record has
      # none, so korrid's status readback (open menu, netplay hosting) crashed
      # RetroArch on the Mini V2 on 2026-10-27. Ship the pinned core info.
      packages = frontend.packages // {
        ${name} = spec.core;
        core-info = pkgs.libretro-core-info;
      };
      files = frontend.files // {
        ${name} = spec.coreFile;
        core-info = "${pkgs.libretro-core-info}/share/retroarch/cores";
      };
    };
}).overrideAttrs
  (old: {
    passthru = (old.passthru or { }) // {
      inherit source coreInfo;
      generatedPlugin = pluginSource;
    };
  })
