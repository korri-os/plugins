+/* Korri-specific, process-local overlay. Native path selection and parsing
+ * have already finished. Keep the original raw bytes (or absence), not just
+ * the parsed index: even invalid native values must survive a flush. */
+static bool core_option_manager_apply_launch_overlay(
+      core_option_manager_t *opt, config_file_t *native)
+{
+   size_t i;
+   const char *path = getenv("KORRI_RETROARCH_CORE_OPTIONS_OVERLAY");
+   config_file_t *overlay;
+
+   if (string_is_empty(path))
+      return true;
+   if (!(overlay = config_file_new_from_path_to_string(path)))
+   {
+      RARCH_ERR("[Core] Cannot read Korri launch core-options overlay.\n");
+      return false;
+   }
+   for (i = 0; i < opt->size; i++)
+   {
+      size_t j;
+      struct core_option *option = &opt->opts[i];
+      struct config_entry_list *entry = config_get_entry(overlay, option->key);
+      struct config_entry_list *original;
+      if (!entry)
+         continue;
+      for (j = 0; j < option->vals->size; j++)
+         if (string_is_equal(option->vals->elems[j].data, entry->value))
+            break;
+      if (j == option->vals->size)
+      {
+         RARCH_ERR("[Core] Invalid Korri launch core-option value.\n");
+         config_file_free(overlay);
+         return false;
+      }
+      original = config_get_entry(native, option->key);
+      if (original && original->value)
+      {
+         option->launch_original_value = strdup(original->value);
+         if (!option->launch_original_value)
+         {
+            config_file_free(overlay);
+            return false;
+         }
+      }
+      option->launch_override = true;
+      option->index = j;
+   }
+   config_file_free(overlay);
+   return true;
+}
+
 /* Parses a single legacy core options interface
