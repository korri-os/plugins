+++ b/menu/menu_setting.c
@@ -1353,7 +1353,7 @@
       const char *parent_group,
       bool dont_use_enum_idx)
 {
-   rarch_setting_t result;
+   rarch_setting_t result = {0};
 
    result.enum_idx                  = MSG_UNKNOWN;
    result.type                      = ST_ACTION;
