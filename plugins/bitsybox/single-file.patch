+/* Korri single-file entry point: retain the selected bytes, never a bounded path. */
+static char* gameData;
+static size_t gameDataLength;
+
+static int readSelectedGame(const char* path) {
+	/* Nonblocking open prevents a FIFO from hanging before fstat refuses it. */
+	int fd = open(path, O_RDONLY | O_NONBLOCK);
+	struct stat info;
+	if (fd < 0) {
+		perror("Cannot open Bitsy file");
+		return 0;
+	}
+	if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) ||
+		info.st_size <= 0 || (uintmax_t) info.st_size > SIZE_MAX - 1) {
+		fprintf(stderr, "Bitsy file must be a nonempty regular file\n");
+		close(fd);
+		return 0;
+	}
+	FILE* file = fdopen(fd, "rb");
+	if (!file) {
+		close(fd);
+		return 0;
+	}
+	gameDataLength = (size_t) info.st_size;
+	gameData = malloc(gameDataLength + 1);
+	int valid = gameData && fread(gameData, 1, gameDataLength, file) == gameDataLength &&
+		!ferror(file) && !memchr(gameData, '\0', gameDataLength);
+	fclose(file);
+	if (!valid) {
+		fprintf(stderr, "Cannot read Bitsy text file\n");
+		free(gameData);
+		gameData = NULL;
+		return 0;
+	}
+	gameData[gameDataLength] = '\0';
+	return 1;
+}
 
