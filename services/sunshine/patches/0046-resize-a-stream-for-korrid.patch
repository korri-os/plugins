+  /**
+   * @brief Korri patch 0046: resize the encoder of the one running stream of a client certificate.
+   *
+   * @param fingerprint SHA-256 fingerprint of the client certificate (patch 0020).
+   * @param display The size that the encoder is to take.
+   * @return The encoder's answer, or a refusal when that client has no running stream or more than one.
+   */
+  korri::runtime_resolution::local_result resize_korri_stream(
+    const std::string &fingerprint,
+    const korri::runtime_resolution::size display
+  ) {
+    namespace rr = korri::runtime_resolution;
+    const auto channels = rtsp_stream::runtime_resolution_channels([&](const std::string &certificate) {
+      try {
+        return korri_certificate_control::validate_single_certificate(certificate).fingerprint == fingerprint;
+      } catch (const std::exception &) {
+        return false;
+      }
+    });
+    // No client has two streams today. Refuse rather than choose one.
+    if (channels.size() != 1) {
+      return {rr::status::failed, channels.empty() ? rr::reason::stream_ended : rr::reason::conflict, {0, 0}};
+    }
+    const auto result = channels.front()->resize(display, rr::channel::lifetime + 500ms);
+    BOOST_LOG(info) << "Korri certificate control: resize to "sv << display.width << 'x' << display.height
+                    << (result.outcome == rr::status::applied ? " applied"sv : " refused, reason "sv)
+                    << (result.outcome == rr::status::applied ? ""s : std::to_string(static_cast<int>(result.why)));
+    return result;
+  }
+
   std::string handle_korri_certificate_request(const std::string &frame) {
     if (client_state_integrity_failed.load()) {
       return korri_certificate_control::error_response("StateIntegrityFailed");
     }
+    if (auto resized = korri_certificate_control::handle_resize_request(frame, http::unique_id, resize_korri_stream)) {
+      return *resized;
+    }
     return korri_certificate_control::handle_serialized_request(
         frame,
         http::unique_id,
