+  std::optional<resize_request> parse_resize_request(
+      const std::string &frame,
+      const std::string_view expected_host_uuid) {
+    if (frame.empty() || frame.size() > max_frame_bytes || frame.find('\0') != std::string::npos) {
+      return std::nullopt;
+    }
+    const auto document = nlohmann::json::parse(frame, nullptr, false);
+    if (document.is_discarded() || !document.is_object()) {
+      return std::nullopt;
+    }
+    const auto operation_name = document.find("operation");
+    if (operation_name == document.end() || !operation_name->is_string() ||
+        operation_name->get_ref<const std::string &>() != "resize") {
+      return std::nullopt;
+    }
+    const auto host = document.find("hostUuid");
+    const auto certificate = document.find("certificate");
+    const auto display = document.find("display");
+    if (document.size() != 4 || host == document.end() || !host->is_string() ||
+        certificate == document.end() || !certificate->is_string() ||
+        display == document.end() || !display->is_object() || display->size() != 2) {
+      throw protocol_error("InvalidFrame", "resize request has an invalid shape");
+    }
+    const auto width = display->find("width");
+    const auto height = display->find("height");
+    constexpr std::uint64_t most = std::numeric_limits<std::uint32_t>::max();
+    if (width == display->end() || height == display->end() ||
+        !width->is_number_unsigned() || !height->is_number_unsigned() ||
+        width->get<std::uint64_t>() > most || height->get<std::uint64_t>() > most) {
+      throw protocol_error("InvalidFrame", "resize request has an invalid display");
+    }
+    if (host->get_ref<const std::string &>() != expected_host_uuid) {
+      throw protocol_error("HostMismatch", "requested host identity does not match this Sunshine instance");
+    }
+    return resize_request {
+        validate_single_certificate(certificate->get<std::string>()).fingerprint,
+        {static_cast<std::uint32_t>(width->get<std::uint64_t>()),
+         static_cast<std::uint32_t>(height->get<std::uint64_t>())},
+    };
+  }
+
+  std::string resize_response(const korri::runtime_resolution::local_result &result) {
+    using korri::runtime_resolution::reason;
+    if (result.outcome == korri::runtime_resolution::status::applied) {
+      auto response = nlohmann::json::object();
+      response["status"] = "ok";
+      response["display"] = {{"width", result.current.width}, {"height", result.current.height}};
+      return response.dump();
+    }
+    switch (result.why) {
+      case reason::invalid_bounds:
+        return error_response("InvalidBounds");
+      case reason::unsupported_encoder:
+        return error_response("UnsupportedEncoder");
+      case reason::apply_failed:
+        return error_response("ApplyFailed");
+      case reason::conflict:
+        return error_response("Conflict");
+      case reason::stream_ended:
+        return error_response("StreamEnded");
+      default:
+        return error_response("InternalError");
+    }
+  }
+
   std::string build_state_document(
       const std::string_view existing_document,
       const std::string_view unique_id,
