+  // Patch 0046: resize the encoder of the stream whose client certificate
+  // matches. The request has patch 0020's mutation fields (operation,
+  // hostUuid, certificate) and the viewer treaty's Resize display.
+  struct resize_request {
+    std::string fingerprint;
+    korri::runtime_resolution::size display;
+  };
+
+  // nullopt: the frame does not ask for a resize, and handle_serialized_request
+  // answers it as before.
+  std::optional<resize_request> parse_resize_request(
+      const std::string &frame,
+      std::string_view expected_host_uuid);
+  // Applied: the encoder's confirmed size. Otherwise patch 0044's reason as the code.
+  std::string resize_response(const korri::runtime_resolution::local_result &result);
+
+  template<typename Resize>
+  std::optional<std::string> handle_resize_request(
+      const std::string &frame,
+      const std::string_view expected_host_uuid,
+      Resize &&resize) {
+    try {
+      const auto parsed = parse_resize_request(frame, expected_host_uuid);
+      if (!parsed) {
+        return std::nullopt;
+      }
+      return resize_response(
+          std::invoke(std::forward<Resize>(resize), parsed->fingerprint, parsed->display));
+    } catch (const protocol_error &error) {
+      return error_response(error.code());
+    } catch (const std::exception &) {
+      return error_response("InternalError");
+    }
+  }
+
   std::string build_state_document(
       std::string_view existing_document,
       std::string_view unique_id,
