+      // Only byte-compatible BGR0 layouts with an explicit linear modifier.
+      // Unknown modifiers, transforms and other formats keep the EGL path.
+      bool copy_linear(const egl::surface_descriptor_t &sd, img_t &img) {
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+        if (capture_rotate_90 || sd.modifier != DRM_FORMAT_MOD_LINEAR ||
+            (sd.fourcc != DRM_FORMAT_XRGB8888 && sd.fourcc != DRM_FORMAT_ARGB8888) ||
+            sd.fds[0] < 0 || sd.fds[1] >= 0 || sd.fds[2] >= 0 || sd.fds[3] >= 0 ||
+            width <= 0 || height <= 0 || img_offset_x < 0 || img_offset_y < 0 ||
+            std::uint64_t(img_offset_x) + width > sd.width ||
+            std::uint64_t(img_offset_y) + height > sd.height ||
+            sd.pitches[0] < std::uint64_t(sd.width) * 4 ||
+            img.pixel_pitch != 4 || img.row_pitch < std::uint64_t(width) * 4) {
+          return false;
+        }
+
+        const std::uint64_t bytes = std::uint64_t(sd.offsets[0]) + std::uint64_t(sd.pitches[0]) * sd.height;
+        auto size = lseek(sd.fds[0], 0, SEEK_END);
+        if (size < 0 || bytes > std::uint64_t(size) || bytes > SIZE_MAX) {
+          return false;
+        }
+        auto map = mmap(nullptr, bytes, PROT_READ, MAP_SHARED, sd.fds[0], 0);
+        if (map == MAP_FAILED) {
+          return false;
+        }
+        auto unmap = util::fail_guard([&]() {
+          munmap(map, bytes);
+        });
+        dma_buf_sync sync {};
+        sync.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ;
+        if (drmIoctl(sd.fds[0], DMA_BUF_IOCTL_SYNC, &sync) < 0) {
+          BOOST_LOG(warning) << "KMS direct readback START sync failed: "sv << strerror(errno);
+          return false;
+        }
+
+        const auto *src = static_cast<const std::uint8_t *>(map) + sd.offsets[0] +
+                          std::uint64_t(img_offset_y) * sd.pitches[0] + std::uint64_t(img_offset_x) * 4;
+        const size_t row_bytes = size_t(width) * 4;
+        // On H700 WC scanout, measured libc memcpy beats NEON LD1 blocks.
+        if (sd.pitches[0] == row_bytes && img.row_pitch == row_bytes) {
+          std::memcpy(img.data, src, row_bytes * height);
+        } else {
+          for (int y = 0; y < height; ++y) {
+            std::memcpy(img.data + size_t(y) * img.row_pitch, src + size_t(y) * sd.pitches[0], row_bytes);
+          }
+        }
+        sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+        if (drmIoctl(sd.fds[0], DMA_BUF_IOCTL_SYNC, &sync) < 0) {
+          BOOST_LOG(warning) << "KMS direct readback END sync failed: "sv << strerror(errno);
+          return false;
+        }
+        return true;
+#else
+        return false;
+#endif
+      }
