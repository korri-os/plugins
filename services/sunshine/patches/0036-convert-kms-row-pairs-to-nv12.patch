diff --git a/src/nv12.h b/src/nv12.h
new file mode 100644
index 0000000..8fca908
--- /dev/null
+++ b/src/nv12.h
@@ -0,0 +1,33 @@
+// Read each write-combined scanout row once into cached scratch RAM.
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <libyuv/convert_from_argb.h>
+#include <vector>
+
+namespace kms {
+  // Caller owns the read-only mapping and brackets access with DMA-BUF sync.
+  // Destinations and scratch are owned RAM, never the compositor's scanout.
+  inline int stage_nv12(const std::uint8_t *source, int source_pitch, int width, int height, std::uint8_t *y, int y_pitch, std::uint8_t *uv, int uv_pitch, std::vector<std::uint8_t> &scratch) {
+    if (!source || !y || !uv || width <= 0 || height <= 0 ||
+        (width & 1) || (height & 1) || width > INT32_MAX / 8 ||
+        source_pitch < width * 4 || y_pitch < width || uv_pitch < width) {
+      return -1;
+    }
+    const size_t row_bytes = size_t(width) * 4;
+    scratch.resize(row_bytes * 2);
+    for (int row = 0; row < height; row += 2) {
+      if (size_t(source_pitch) == row_bytes) {
+        std::memcpy(scratch.data(), source + size_t(row) * source_pitch, row_bytes * 2);
+      } else {
+        std::memcpy(scratch.data(), source + size_t(row) * source_pitch, row_bytes);
+        std::memcpy(scratch.data() + row_bytes, source + size_t(row + 1) * source_pitch, row_bytes);
+      }
+      int status = libyuv::ARGBToNV12(scratch.data(), int(row_bytes), y + size_t(row) * y_pitch, y_pitch, uv + size_t(row / 2) * uv_pitch, uv_pitch, width, 2);
+      if (status != 0) {
+        return status;
+      }
+    }
+    return 0;
+  }
+}  // namespace kms
