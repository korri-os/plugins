+      BOOST_LOG(error) << "Failed to map screencopy SHM file"sv;
+      close(fd);
+      zwlr_screencopy_frame_v1_destroy(frame);
+      status = REINIT;
+      return;
+    }
+
+    auto pool = wl_shm_create_pool(shm_interface, fd, (int) size);
+    if (!pool) {
+      BOOST_LOG(error) << "Failed to create screencopy SHM pool"sv;
+      close(fd);
+      munmap(data, size);
+      zwlr_screencopy_frame_v1_destroy(frame);
+      status = REINIT;
+      return;
+    }
+    auto buffer = wl_shm_pool_create_buffer(
