+    close(fd);
+
+    if (!buffer) {
+      BOOST_LOG(error) << "Failed to create screencopy SHM buffer"sv;
+      munmap(data, size);
+      zwlr_screencopy_frame_v1_destroy(frame);
+      status = REINIT;
+      return;
+    }
+
+    next_frame->sd.width = shm_info.width;
+    next_frame->sd.height = shm_info.height;
