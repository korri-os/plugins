diff --git a/src/runtime-resolution-channel.h b/src/runtime-resolution-channel.h
new file mode 100644
index 0000000..762b9f3
--- /dev/null
+++ b/src/runtime-resolution-channel.h
@@ -0,0 +1,109 @@
+#pragma once
+#include "runtime-resolution-wire.h"
+#include <algorithm>
+#include <chrono>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+namespace korri::runtime_resolution {
+inline constexpr auto channel_name = "korri-runtime-resolution";
+
+// One instance per authenticated stream. Only the encoder thread takes work.
+// The control thread never changes encoder resources or writes config fields.
+class channel {
+ public:
+  using clock = std::chrono::steady_clock;
+  struct work { ::korri::runtime_resolution::request request; clock::time_point deadline; };
+  channel(size launch, std::uint32_t bitrate, std::uint32_t fps)
+      : launch_(launch), current_(launch), bitrate_(bitrate), fps_(fps) {}
+
+  void supported(bool value) {
+    std::lock_guard guard(mutex_);
+    supported_ = value && !closed_;
+    if (query_id_ && !closed_) {
+      auto bytes = capabilities(*query_id_, *supported_, bitrate_, fps_, launch_, current_);
+      replies_.emplace_back(bytes.begin(), bytes.end());
+      query_id_.reset();
+    }
+  }
+  void suspend() {
+    std::lock_guard guard(mutex_);
+    if (!closed_) supported_.reset();
+  }
+  std::vector<std::uint8_t> submit(const request &request, clock::time_point now) {
+    std::lock_guard guard(mutex_);
+    if (closed_) return {};
+    if (request.operation == query) {
+      if (!supported_.has_value() && request.refusal == reason::none) {
+        query_id_ = std::max(query_id_.value_or(0), request.id);
+        return {};
+      }
+      auto bytes = capabilities(request.id, supported_.value_or(false) && request.refusal == reason::none,
+                                bitrate_, fps_, launch_, current_);
+      return {bytes.begin(), bytes.end()};
+    }
+    if (request.operation != resolution) return {};
+    auto refuse = [&](reason why) {
+      auto bytes = resolution_ack(request.id, status::failed, why, current_);
+      return std::vector<std::uint8_t>(bytes.begin(), bytes.end());
+    };
+    if (request.refusal != reason::none) return refuse(request.refusal);
+    if (!supported_.value_or(false)) return refuse(reason::unsupported_encoder);
+    if (request.id <= last_id_ || pending_ || !replies_.empty()) return refuse(reason::conflict);
+    last_id_ = request.id;
+    pending_ = work {request, now + std::chrono::milliseconds(2500)};
+    taken_ = false;
+    return {};
+  }
+  std::optional<work> take() {
+    std::lock_guard guard(mutex_);
+    if (closed_ || !pending_ || taken_) return std::nullopt;
+    taken_ = true;
+    return pending_;
+  }
+  // Commit is performed only after a first candidate IDR has been encoded.
+  // The callback swaps in the prepared encoder and queues that frame. No GPU
+  // operation belongs in this critical section. A closed/expired request
+  // cannot publish an encoder or a frame after the stream is gone.
+  template<class Commit>
+  bool finish(const work &work, bool success, Commit commit) {
+    std::lock_guard guard(mutex_);
+    if (closed_ || !pending_ || pending_->request.id != work.request.id) return false;
+    success = success && clock::now() < work.deadline;
+    if (success) {
+      commit();
+      current_ = work.request.target;
+    }
+    auto bytes = resolution_ack(work.request.id, success ? status::applied : status::failed,
+                                success ? reason::none : reason::apply_failed, current_);
+    replies_.emplace_back(bytes.begin(), bytes.end());
+    pending_.reset();
+    return success;
+  }
+  std::optional<std::vector<std::uint8_t>> reply() {
+    std::lock_guard guard(mutex_);
+    if (replies_.empty()) return std::nullopt;
+    auto bytes = std::move(replies_.front());
+    replies_.pop_front();
+    return bytes;
+  }
+  void close() {
+    std::lock_guard guard(mutex_);
+    closed_ = true;
+    supported_ = false;
+    pending_.reset();
+    query_id_.reset();
+    replies_.clear();
+  }
+ private:
+  std::mutex mutex_;
+  size launch_, current_;
+  std::uint32_t bitrate_, fps_, last_id_ = 0;
+  std::optional<bool> supported_;
+  std::optional<std::uint32_t> query_id_;
+  bool closed_ = false, taken_ = false;
+  std::optional<work> pending_;
+  std::deque<std::vector<std::uint8_t>> replies_;
+};
+} // namespace korri::runtime_resolution
diff --git a/src/runtime-resolution-wire.h b/src/runtime-resolution-wire.h
new file mode 100644
index 0000000..cc2cd60
--- /dev/null
+++ b/src/runtime-resolution-wire.h
@@ -0,0 +1,116 @@
+#pragma once
+
+// Wire boundary for the existing Android SunshineRuntimeSettings request.
+// Packet IDs 0x5504/0x5505 and payload offsets come from
+// moonlight-common-c/src/SunshineRuntimeSettings.{c,h}. No bitrate or FPS
+// mutation is enabled by this implementation.
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace korri::runtime_resolution {
+constexpr std::uint16_t request_packet = 0x5504;
+constexpr std::uint16_t ack_packet = 0x5505;
+constexpr std::uint16_t query = 0;
+constexpr std::uint16_t resolution = 3;
+constexpr std::uint32_t resolution_bit = 1u << resolution;
+
+enum class status : std::uint16_t { applied = 0, failed = 1, invalid = 2 };
+enum class reason : std::uint16_t {
+  none = 0, invalid_bounds = 2, invalid_payload = 3,
+  unsupported_encoder = 4, unsupported_operation = 6, apply_failed = 7,
+  conflict = 10, stream_ended = 12,
+};
+
+struct size {
+  std::uint32_t width;
+  std::uint32_t height;
+  bool operator==(const size &) const = default;
+};
+
+constexpr bool valid(size value) {
+  return value.width > 0 && value.height > 0 && value.width <= 4096 &&
+         value.height <= 4096 && value.width % 2 == 0 && value.height % 2 == 0;
+}
+
+inline std::uint16_t read16(std::span<const std::uint8_t> bytes, unsigned offset) {
+  return bytes[offset] | (std::uint16_t(bytes[offset + 1]) << 8);
+}
+inline std::uint32_t read32(std::span<const std::uint8_t> bytes, unsigned offset) {
+  return read16(bytes, offset) | (std::uint32_t(read16(bytes, offset + 2)) << 16);
+}
+inline void write16(std::span<std::uint8_t> bytes, unsigned offset, std::uint16_t value) {
+  bytes[offset] = value & 0xff;
+  bytes[offset + 1] = value >> 8;
+}
+inline void write32(std::span<std::uint8_t> bytes, unsigned offset, std::uint32_t value) {
+  write16(bytes, offset, value & 0xffff);
+  write16(bytes, offset + 2, value >> 16);
+}
+
+struct request {
+  std::uint32_t id;
+  std::uint16_t operation;
+  size target;
+  reason refusal;
+};
+
+// A truncated header cannot be correlated safely. Invalid complete requests
+// retain their identity so the caller can send a bounded rejection.
+inline std::optional<request> decode(std::span<const std::uint8_t> bytes) {
+  if (bytes.size() < 8) return std::nullopt;
+  request result {read32(bytes, 0), read16(bytes, 4), {0, 0}, reason::none};
+  if (!result.id || read16(bytes, 6) != 0) {
+    result.refusal = reason::invalid_payload;
+  } else if (result.operation == query) {
+    if (bytes.size() != 8) result.refusal = reason::invalid_payload;
+  } else if (result.operation == resolution) {
+    if (bytes.size() != 16) {
+      result.refusal = reason::invalid_payload;
+    } else {
+      result.target = {read32(bytes, 8), read32(bytes, 12)};
+      if (!valid(result.target)) result.refusal = reason::invalid_bounds;
+    }
+  } else {
+    result.refusal = reason::unsupported_operation;
+  }
+  return result;
+}
+
+// Call only with the confirmed encoder size. Queuing a resize is not an ACK.
+inline std::array<std::uint8_t, 20> resolution_ack(
+    std::uint32_t id, status outcome, reason why, size current) {
+  std::array<std::uint8_t, 20> bytes {};
+  write32(bytes, 0, id);
+  write16(bytes, 4, resolution);
+  write16(bytes, 6, static_cast<std::uint16_t>(outcome));
+  write32(bytes, 8, current.width);
+  write32(bytes, 12, current.height);
+  write16(bytes, 16, static_cast<std::uint16_t>(why));
+  return bytes;
+}
+
+// Launch values remain immutable across queries. Bitrate/FPS are observed
+// facts only; their operation bits remain unset.
+inline std::array<std::uint8_t, 64> capabilities(
+    std::uint32_t id, bool supported, std::uint32_t bitrate, std::uint32_t fps,
+    size launch, size current) {
+  std::array<std::uint8_t, 64> bytes {};
+  write32(bytes, 0, id);
+  write16(bytes, 4, query);
+  write16(bytes, 6, static_cast<std::uint16_t>(supported ? status::applied : status::failed));
+  write16(bytes, 8, static_cast<std::uint16_t>(supported ? reason::none : reason::unsupported_encoder));
+  write32(bytes, 12, supported ? resolution_bit : 0);
+  write32(bytes, 28, fps);
+  write32(bytes, 32, bitrate);
+  write32(bytes, 36, fps);
+  write32(bytes, 40, launch.width);
+  write32(bytes, 44, launch.height);
+  write32(bytes, 48, bitrate);
+  write32(bytes, 52, fps);
+  write32(bytes, 56, current.width);
+  write32(bytes, 60, current.height);
+  return bytes;
+}
+} // namespace korri::runtime_resolution
