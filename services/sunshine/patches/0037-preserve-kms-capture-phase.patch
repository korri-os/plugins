@@ -0,0 +1,77 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string_view>
+
+namespace platf::kms {
+  inline constexpr int default_vblank_offset_ms = 0;
+
+  // Linux RAM KMS only. Configuration is milliseconds, not a display mode.
+  inline std::optional<int> parse_vblank_offset_ms(std::string_view value) {
+    if (value.empty()) {
+      return std::nullopt;
+    }
+    int result = 0;
+    for (char c : value) {
+      if (c < '0' || c > '9' || result > 1000 / 10) {
+        return std::nullopt;
+      }
+      result = result * 10 + c - '0';
+      if (result > 1000) {
+        return std::nullopt;
+      }
+    }
+    return result;
+  }
+
+  // DRM mode.clock is kHz; totals are pixels/lines. The mode is an
+  // applicability check only. Vblank timestamps drive capture deadlines.
+  inline std::optional<std::int64_t> mode_period_ns(std::uint32_t clock_khz, std::uint16_t htotal, std::uint16_t vtotal, bool interlaced, bool doublescan, std::uint16_t vscan) {
+    if (!clock_khz || !htotal || !vtotal) {
+      return std::nullopt;
+    }
+    std::uint64_t numerator = std::uint64_t(htotal) * vtotal * 1000000;
+    std::uint64_t scan = std::uint64_t(doublescan ? 2 : 1) * (vscan > 1 ? vscan : 1);
+    if (numerator > std::uint64_t(std::numeric_limits<std::int64_t>::max()) / scan) {
+      return std::nullopt;
+    }
+    numerator *= scan;
+    std::uint64_t denominator = std::uint64_t(clock_khz) * (interlaced ? 2 : 1);
+    return static_cast<std::int64_t>(numerator / denominator);
+  }
+
+  inline bool compatible_vblank_period(std::int64_t period, std::int64_t requested, std::int64_t offset) {
+    if (period <= 0 || requested <= 0 || offset < 0 || offset >= period) {
+      return false;
+    }
+    auto difference = period > requested ? period - requested : requested - period;
+    // Preserve negotiated FPS on other displays; allow the measured panel's
+    // small difference from nominal 60 Hz, not a different refresh multiple.
+    return difference <= (period > requested ? period : requested) / 1000;
+  }
+
+  inline bool usable_vblank(std::uint32_t sequence, std::optional<std::uint32_t> last, std::int64_t timestamp, std::int64_t now, std::int64_t period, std::int64_t wait_began, std::int64_t offset) {
+    // Query/wakeup overshoot is allowed only if waiting began before the
+    // phase deadline. A late caller must not start FIFO catch-up work.
+    return timestamp > 0 && now >= timestamp && period > 0 && offset >= 0 && offset < period &&
+           timestamp <= std::numeric_limits<std::int64_t>::max() - offset && wait_began >= 0 &&
+           wait_began <= timestamp + offset && (!last || sequence != *last) && now - timestamp < period;
+  }
+
+  inline std::optional<std::int64_t> future_nominal_deadline_ns(std::int64_t previous, std::int64_t now, std::int64_t period) {
+    if (previous < 0 || now < 0 || period <= 0) {
+      return std::nullopt;
+    }
+    if (previous > now) {
+      return previous;
+    }
+    auto elapsed = (now - previous) / period;
+    auto capacity = (std::numeric_limits<std::int64_t>::max() - previous) / period;
+    if (elapsed >= capacity) {
+      return std::nullopt;
+    }
+    return previous + (elapsed + 1) * period;
+  }
+}  // namespace platf::kms
diff --git a/src/kms_capture_rt_guard.h b/src/kms_capture_rt_guard.h
new file mode 100644
--- /dev/null
+++ b/src/kms_capture_rt_guard.h
@@ -0,0 +1,205 @@
+#pragma once
+
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <sched.h>
+#include <sys/resource.h>
+#include <thread>
+#include <time.h>
+
+namespace platf::kms {
+  enum class capture_rt_guard_result {
+    ready,
+    degraded,
+    sleep_only
+  };
+  enum class capture_rt_guard_reason {
+    none,
+    no_pacing_calls,
+    repeated_sequence,
+    backwards_sequence,
+    policy_unknown
+  };
+
+  // Driver wait calls may legitimately return immediately at the next vblank.
+  // Neither CPU share nor sleep duration identifies that as a spin.
+  class capture_pacing_history_t {
+  public:
+    capture_rt_guard_reason observe(unsigned pacing_calls, std::optional<std::uint32_t> sequence) {
+      without_pacing = pacing_calls ? 0 : without_pacing + 1;
+      bool backwards = false;
+      if (sequence) {
+        if (previous_sequence) {
+          auto delta = std::uint32_t(*sequence - *previous_sequence);
+          backwards = delta >= (std::uint32_t(1) << 31);
+          repeated = delta == 0 ? repeated + 1 : 1;
+        } else {
+          repeated = 1;
+        }
+      } else {
+        repeated = 0;
+      }
+      previous_sequence = sequence;
+      if (backwards) {
+        return capture_rt_guard_reason::backwards_sequence;
+      }
+      if (repeated >= 3) {
+        return capture_rt_guard_reason::repeated_sequence;
+      }
+      if (without_pacing >= 3) {
+        return capture_rt_guard_reason::no_pacing_calls;
+      }
+      return capture_rt_guard_reason::none;
+    }
+
+    unsigned without_pacing = 0;
+    unsigned repeated = 0;
+    std::optional<std::uint32_t> previous_sequence;
+  };
+
+  struct capture_rt_guard_observation {
+    std::array<std::int64_t, 3> acquisition_end_ns {};
+    std::int64_t decision_ns = 0;
+    std::int64_t pacing_start_ns = 0;
+    std::int64_t cpu_ns = 0;
+    std::int64_t wall_ns = 0;
+    std::int64_t blocked_ns = 0;
+    unsigned pacing_calls = 0;
+    unsigned consecutive_unpaced = 0;
+    unsigned repeated_sequence = 0;
+    std::optional<std::uint32_t> sequence;
+    std::optional<std::uint32_t> previous_sequence;
+  };
+
+  class capture_rt_guard_t {
+  public:
+    capture_rt_guard_t() {
+      auto policy = sched_getscheduler(0);
+      auto base = policy & ~SCHED_RESET_ON_FORK;
+      if (policy < 0) {
+        state = state_t::unverified;
+      } else if (base == SCHED_OTHER || base == SCHED_BATCH || base == SCHED_IDLE) {
+        state = state_t::unrestricted;
+      } else {
+        state = state_t::realtime;
+      }
+    }
+
+    void begin_pacing() {
+      if (state == state_t::realtime || state == state_t::unverified) {
+        pacing_start = measure();
+      }
+    }
+
+    capture_rt_guard_result before_acquisition(std::chrono::nanoseconds period, unsigned pacing_calls, std::optional<std::uint32_t> sequence) {
+      if (state == state_t::sleep_only) {
+        std::this_thread::sleep_for(period);
+        return capture_rt_guard_result::sleep_only;
+      }
+      if (state == state_t::unrestricted) {
+        return capture_rt_guard_result::ready;
+      }
+      auto after = measure();
+      detail.decision_ns = after ? after->wall_ns : 0;
+      detail.pacing_start_ns = pacing_start ? pacing_start->wall_ns : 0;
+      detail.wall_ns = after && pacing_start ? after->wall_ns - pacing_start->wall_ns : 0;
+      detail.cpu_ns = after && pacing_start ? after->cpu_ns - pacing_start->cpu_ns : 0;
+      bool switched = after && pacing_start && after->voluntary_switches > pacing_start->voluntary_switches;
+      detail.blocked_ns = switched && detail.cpu_ns >= 0 && detail.wall_ns >= detail.cpu_ns ? detail.wall_ns - detail.cpu_ns : 0;
+      detail.pacing_calls = pacing_calls;
+      detail.sequence = sequence;
+      detail.previous_sequence = history.previous_sequence;
+      trigger = state == state_t::unverified ? capture_rt_guard_reason::policy_unknown : history.observe(pacing_calls, sequence);
+      detail.consecutive_unpaced = history.without_pacing;
+      detail.repeated_sequence = history.repeated;
+      if (trigger == capture_rt_guard_reason::none) {
+        return capture_rt_guard_result::ready;
+      }
+      sched_param param {};
+      // An unprivileged thread may add RESET_ON_FORK but cannot clear it.
+      if (sched_setscheduler(0, SCHED_OTHER | SCHED_RESET_ON_FORK, &param)) {
+        failure_errno = errno;
+        state = state_t::sleep_only;
+        std::this_thread::sleep_for(period);
+        return capture_rt_guard_result::sleep_only;
+      }
+      state = state_t::unrestricted;
+      return capture_rt_guard_result::degraded;
+    }
+
+    void acquisition_complete() {
+      if (state == state_t::realtime) {
+        detail.acquisition_end_ns[0] = detail.acquisition_end_ns[1];
+        detail.acquisition_end_ns[1] = detail.acquisition_end_ns[2];
+        detail.acquisition_end_ns[2] = clock_ns(CLOCK_MONOTONIC).value_or(0);
+      }
+    }
+
+    int error() const {
+      return failure_errno;
+    }
+
+    capture_rt_guard_reason reason_code() const {
+      return trigger;
+    }
+
+    const capture_rt_guard_observation &observation() const {
+      return detail;
+    }
+
+    const char *reason() const {
+      switch (trigger) {
+        case capture_rt_guard_reason::none:
+          return "none";
+        case capture_rt_guard_reason::no_pacing_calls:
+          return "three acquisitions without a pacing call";
+        case capture_rt_guard_reason::repeated_sequence:
+          return "three acquisitions with the same vblank sequence";
+        case capture_rt_guard_reason::backwards_sequence:
+          return "vblank sequence moved backwards";
+        case capture_rt_guard_reason::policy_unknown:
+          return "sched_getscheduler failed";
+      }
+      return "invalid guard reason";
+    }
+
+  private:
+    struct measurement {
+      std::int64_t wall_ns, cpu_ns;
+      long voluntary_switches;
+    };
+
+    static std::optional<std::int64_t> clock_ns(clockid_t clock) {
+      timespec value {};
+      if (clock_gettime(clock, &value)) {
+        return std::nullopt;
+      }
+      return std::int64_t(value.tv_sec) * 1000000000 + value.tv_nsec;
+    }
+
+    static std::optional<measurement> measure() {
+      auto wall = clock_ns(CLOCK_MONOTONIC);
+      auto cpu = clock_ns(CLOCK_THREAD_CPUTIME_ID);
+      rusage usage {};
+      if (!wall || !cpu || getrusage(RUSAGE_THREAD, &usage) || usage.ru_nvcsw < 0) {
+        return std::nullopt;
+      }
+      return measurement {*wall, *cpu, usage.ru_nvcsw};
+    }
+    enum class state_t {
+      unrestricted,
+      realtime,
+      unverified,
+      sleep_only
+    };
+    state_t state;
+    capture_pacing_history_t history;
+    std::optional<measurement> pacing_start;
+    capture_rt_guard_observation detail;
+    capture_rt_guard_reason trigger = capture_rt_guard_reason::none;
+    int failure_errno = 0;
+  };
+}  // namespace platf::kms
