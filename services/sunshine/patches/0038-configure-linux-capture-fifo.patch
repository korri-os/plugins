What: parse capture_rt_priority=0 (off) or 1..20. Only a guarded RAM-KMS
backend with an established vblank lock may request calling-thread FIFO with
SCHED_RESET_ON_FORK. Other backends never request RT, regardless of config.
The ARM backend owns promotion, operational logging, guard and scope cleanup;
the generic asynchronous Linux capture loop has no FIFO request.
Status: bounded, backend-specific opt-in scheduling; native LimitRTPRIO remains
an explicit host approval. No service-wide RT, affinity or SYS_NICE.
Evidence: capture-scheduling-test.cpp checks other backends cannot request FIFO,
lock-before-promotion, strict parsing and unprivileged EPERM continuation.
Removal: equivalent upstream policy, lost need, or unsafe responsiveness.

diff --git a/src/capture_scheduling.h b/src/capture_scheduling.h
new file mode 100644
--- /dev/null
+++ b/src/capture_scheduling.h
@@ -0,0 +1,45 @@
+// Capture-only scheduling policy. No service-wide or affinity change.
+#pragma once
+#include <charconv>
+#include <optional>
+#include <string_view>
+#ifdef __linux__
+  #include <cerrno>
+  #include <sched.h>
+#endif
+
+namespace video {
+  enum class capture_backend {
+    other,
+    guarded_ram_kms
+  };
+
+  // Zero disables the request. Invalid values must not acquire RT authority.
+  inline std::optional<int> parse_capture_rt_priority(std::string_view value) {
+    int priority = 0;
+    auto result = std::from_chars(value.data(), value.data() + value.size(), priority);
+    if (result.ec != std::errc() || result.ptr != value.data() + value.size() || priority < 0 || priority > 20) {
+      return std::nullopt;
+    }
+    return priority;
+  }
+
+  inline int request_capture_scheduling(int priority, capture_backend backend = capture_backend::other, bool vblank_locked = false) {
+#ifdef __linux__
+    if (backend != capture_backend::guarded_ram_kms || !vblank_locked || priority == 0) {
+      return 0;
+    }
+    if (priority < 1 || priority > 20) {
+      return EINVAL;
+    }
+    sched_param param {};
+    param.sched_priority = priority;
+    // pid 0 names only the calling Linux thread, not its process or siblings.
+    // Reset-on-fork prevents a later child process from inheriting RT policy.
+    if (sched_setscheduler(0, SCHED_FIFO | SCHED_RESET_ON_FORK, &param) < 0) {
+      return errno;
+    }
+#endif
+    return 0;
+  }
+}  // namespace video
