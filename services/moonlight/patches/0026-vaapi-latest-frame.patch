 static int pipefd[2];
+static pthread_mutex_t frame_mutex = PTHREAD_MUTEX_INITIALIZER;
+static AVFrame* pending_frame;
+
+// Own the decoded buffer until presentation ends. The decoder reuses its
+// AVFrame wrappers, so neither the slot nor the renderer may borrow one.
+static void queue_frame(AVFrame* frame) {
+  AVFrame* owned = av_frame_clone(frame);
+  if (!owned) {
+    fprintf(stderr, "Couldn't retain decoded frame\n");
+    return;
+  }
+  pthread_mutex_lock(&frame_mutex);
+  bool notify = pending_frame == NULL;
+  av_frame_free(&pending_frame);
+  pending_frame = owned;
+  if (notify) {
+    char notification = 0;
+    ssize_t result;
+    do {
+      result = write(pipefd[1], &notification, sizeof(notification));
+    } while (result < 0 && errno == EINTR);
+    if (result != sizeof(notification)) {
+      perror("Couldn't notify presentation loop");
+      av_frame_free(&pending_frame);
+    }
+  }
+  pthread_mutex_unlock(&frame_mutex);
+}

