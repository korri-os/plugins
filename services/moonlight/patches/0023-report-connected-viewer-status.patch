+static int korri_width, korri_height;
+void connection_set_stream_size(int width, int height) {
+  korri_width = width;
+  korri_height = height;
+}
+
+static void korri_notify(const char* status) {
+  const char* path = getenv("NOTIFY_SOCKET");
+  if (!path || !*path) return;
+  struct sockaddr_un address = { .sun_family = AF_UNIX };
+  size_t length = strlen(path);
+  if (length >= sizeof(address.sun_path) || (path[0] != '/' && path[0] != '@')) return;
+  memcpy(address.sun_path, path, length + 1);
+  if (path[0] == '@') address.sun_path[0] = 0;
+  int socket_fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+  if (socket_fd < 0) return;
+  sendto(socket_fd, status, strlen(status), MSG_NOSIGNAL,
+    (struct sockaddr*)&address, offsetof(struct sockaddr_un, sun_path) + length + (path[0] == '@' ? 0 : 1));
+  close(socket_fd);
+}
+static void connection_started(void) {
+  struct timespec now;
+  if (korri_width <= 0 || korri_height <= 0 || clock_gettime(CLOCK_MONOTONIC, &now)) return;
+  char status[160];
+  snprintf(status, sizeof(status), "STATUS=korri-viewer-connected:%ld:%lld:%ld:%d:%d", (long)getpid(),
+    (long long)now.tv_sec, now.tv_nsec, korri_width, korri_height);
+  korri_notify(status);
+}
+
 static void connection_terminated(int errorCode) {
+  korri_notify("STATUS=korri-viewer-disconnected");
   switch (errorCode) {
   case ML_ERROR_GRACEFUL_TERMINATION:
     printf("Connection has been terminated gracefully.\n");
